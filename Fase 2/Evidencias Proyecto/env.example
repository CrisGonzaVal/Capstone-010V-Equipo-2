# =====================================================
# CompuStock ERP - variables de entorno (plantilla)
# =====================================================
# Uso: copia este archivo a `.env` en la raiz del proyecto y completa los
# valores. `.env` esta ignorado por git (nunca sube secretos); este ejemplo NO.
#
#   cp env.example .env        (Linux/macOS)
#   copy env.example .env      (Windows cmd)
#
# `docker compose` lee `.env` automaticamente.
# =====================================================

# --- PostgreSQL (servicio `db`) ---
# Credenciales y nombre de la base local. Los defaults de docker-compose.yml ya
# sirven para un entorno de desarrollo; definelos solo para cambiarlos.
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=apt_erp

# DB_PORT = puerto HOST de PostgreSQL. OJO: docker-compose.yml reutiliza esta
# misma variable para el backend y para el mapeo del puerto. Dejala COMENTADA
# para `docker compose up -d`: con el default, la base queda accesible en el host
# en 5433 y el backend conecta al 5432 interno del contenedor. Si la defines en
# 5433, el backend intentara `db:5433` y fallara.
# DB_PORT=5433

# --- Clerk (unica autoridad de autenticacion, Feature 006) ---
# Completa estas tres con las de tu instancia de Clerk (dashboard > API keys).
# Sin valores reales, el frontend no puede iniciar sesion.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_ISSUER=
